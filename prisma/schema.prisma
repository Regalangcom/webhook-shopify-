generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AbandonedCart {
  id             String     @id @default(cuid())
  cartToken      String     @unique
  products       Json
  checkoutUrl    String?
  totalPrice     String?
  currency       String?
  customerPhone  String?
  customerEmail  String?
  customerName   String?
  status         CartStatus @default(ACTIVE)
  reminderSent   Boolean    @default(false)
  remindersCount Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  reminders CartReminder[]

  @@map("abandoned_carts")
}

model CartReminder {
  id          String         @id @default(cuid())
  cartId      String
  cart        AbandonedCart  @relation(fields: [cartId], references: [id])
  jobId       String?
  stage       Int
  scheduledAt DateTime
  sentAt      DateTime?
  status      ReminderStatus @default(PENDING)
  error       String?
  createdAt   DateTime       @default(now())

  @@map("cart_reminders")
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}
