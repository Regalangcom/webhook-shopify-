# ─── Server ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/shopify_webhook?schema=public"

# ─── Redis (required by Bull queue) ───────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password   # uncomment if Redis has auth

# ─── Shopify ──────────────────────────────────────────────────
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret_here
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_API_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2024-01

# ─── Fonte WhatsApp API ────────────────────────────────────────
FONTE_API_URL=https://api.fonteapi.com/v1
FONTE_API_TOKEN=your_fonte_api_token_here
FONTE_SENDER_ID=your_sender_id_or_number

# ─── Reminder Schedule (in milliseconds) ─────────────────────
# First reminder after 1 hour (3600000 ms)
REMINDER_DELAY_1=3600000
# Second reminder after 24 hours (86400000 ms)
REMINDER_DELAY_2=86400000

# ─── Dashboard ────────────────────────────────────────────────
DASHBOARD_SECRET=a_strong_secret_for_dashboard_access
